{
    "name": "justinholtweb/craft-subscribr",
    "description": "Recurring commerce for Craft — subscription boxes, skip/pause/swap, prepaid and gift plans, mixed carts, proration and dunning, on any gateway that can store a payment source.",
    "type": "craft-plugin",
    "keywords": [
        "craftcms",
        "craft-plugin",
        "craft-commerce",
        "commerce",
        "subscriptions",
        "recurring",
        "subscription-box",
        "dunning",
        "billing"
    ],
    "license": "proprietary",
    "homepage": "https://justinholt.com/plugins/craft-subscribr",
    "authors": [
        {
            "name": "Justin Holt",
            "homepage": "https://justinholt.com"
        }
    ],
    "support": {
        "email": "justin@justinholt.com",
        "issues": "https://github.com/justinholtweb/craft-subscribr/issues",
        "source": "https://github.com/justinholtweb/craft-subscribr",
        "docs": "https://justinholt.com/plugins/craft-subscribr/docs"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "craftcms/cms": "^5.3.0",
        "craftcms/commerce": "^5.0.0"
    },
    "require-dev": {
        "craftcms/ecs": "dev-main",
        "craftcms/phpstan": "dev-main",
        "phpstan/phpstan": "^1.12 || ^2.2"
    },
    "autoload": {
        "psr-4": {
            "justinholtweb\\subscribr\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "craftcms/plugin-installer": true,
            "yiisoft/yii2-composer": true
        }
    },
    "extra": {
        "name": "Subscribr",
        "handle": "subscribr",
        "developer": "Justin Holt",
        "developerUrl": "https://justinholt.com",
        "documentationUrl": "https://justinholt.com/plugins/craft-subscribr/docs",
        "changelogUrl": "https://raw.githubusercontent.com/justinholtweb/craft-subscribr/main/CHANGELOG.md",
        "class": "justinholtweb\\subscribr\\Plugin"
    },
    "scripts": {
        "phpstan": "phpstan analyse --memory-limit=1G",
        "ecs": "ecs check --ansi",
        "ecs-fix": "ecs check --fix --ansi"
    }
}
