{#
   Subscribr's own email shell.

   Plain on purpose. These messages are meant to be replaced by the store's own — point
   `emailTemplates` at your templates in the settings — and until they are, a store should still
   be sending something that reads like a person wrote it.
#}
<!DOCTYPE html>
<html>
<body style="font-family: -apple-system, Segoe UI, Helvetica, Arial, sans-serif; font-size: 15px; line-height: 1.5; color: #1c1c1c; max-width: 560px; margin: 0 auto; padding: 24px;">
    {% block body %}{% endblock %}

    {% if portalUrl is defined and portalUrl %}
        <p style="margin-top: 28px;">
            <a href="{{ portalUrl }}" style="background: #1c1c1c; color: #fff; padding: 10px 18px; border-radius: 4px; text-decoration: none; display: inline-block;">
                {{ 'Manage your subscription'|t('subscribr') }}
            </a>
        </p>
    {% endif %}

    <p style="color: #888; font-size: 13px; margin-top: 32px;">{{ craft.app.systemName }}</p>
</body>
</html>
